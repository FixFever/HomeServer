# Пример для основного docker-compose.yml

# Общие настройки
DOMAIN=example.invalid

# Общие параметры PostgreSQL (используются несколькими сервисами)
POSTGRES_USER=example_user
POSTGRES_PASSWORD='fake-postgres-password-$NOT_REAL'
NEXTCLOUD_POSTGRES_DB=nextcloud_example

# Traefik
TLS_EMAIL=admin@example.invalid

# CrowdSec Web UI
CROWDSEC_WEBUI_USER=example_crowdsec_user
CROWDSEC_WEBUI_PASSWORD='fake-crowdsec-password'

# Watchtower
TELEGRAM_BOT_TOKEN='123456789:FAKE_TOKEN_NOT_VALID'
CHAT_ID=123456789

# Homarr
HOMARR_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Nextcloud
NEXTCLOUD_ADMIN_USER=example_admin
NEXTCLOUD_ADMIN_PASSWORD='fake-nextcloud-password'

# pgAdmin
PGADMIN_DEFAULT_EMAIL=pgadmin@example.invalid
PGADMIN_DEFAULT_PASSWORD='fake-pgadmin-password'

# Immich
IMMICH_API_KEY=fake-immich-api-key-not-valid

# Grafana
GRAFANA_ADMIN_USER=example_grafana_admin
GRAFANA_ADMIN_PASSWORD='fake-grafana-password'

# Vaultwarden
VAULT_ADMIN_TOKEN='fake-vaultwarden-token-not-valid'

# Chrome
CHROME_PASSWORD='fake-chrome-password'
